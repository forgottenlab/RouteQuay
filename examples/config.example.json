{
  "schemaVersion": "example-v1",
  "redaction": {
    "status": "redacted-example",
    "note": "Placeholder values only. Do not use as production Xray config."
  },
  "node": {
    "id": "tokyo-demo-node",
    "displayName": "Tokyo Demo Node",
    "region": "ap-northeast-example",
    "host": "vpn.example.invalid",
    "xrayConfigPath": "/usr/local/etc/xray/config.json"
  },
  "xray": {
    "log": {
      "loglevel": "warning"
    },
    "inbounds": [
      {
        "tag": "vless-reality-demo",
        "listen": "0.0.0.0",
        "port": 443,
        "protocol": "vless",
        "settings": {
          "clients": [
            {
              "id": "example-client-alpha-id",
              "email": "alpha@example.invalid",
              "flow": "xtls-rprx-vision"
            }
          ],
          "decryption": "none"
        },
        "streamSettings": {
          "network": "tcp",
          "security": "reality",
          "realitySettings": {
            "show": false,
            "dest": "www.example.com:443",
            "serverNames": [
              "www.example.com"
            ],
            "privateKey": "EXAMPLE_REDACTED_PRIVATE_KEY_DO_NOT_USE",
            "shortIds": [
              "not-a-real-short-id"
            ]
          }
        }
      }
    ],
    "outbounds": [
      {
        "protocol": "freedom",
        "tag": "direct"
      },
      {
        "protocol": "blackhole",
        "tag": "block"
      }
    ]
  }
}
