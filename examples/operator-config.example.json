{
  "schemaVersion": "routequay-operator-config-v1",
  "ssh": {
    "configPath": "~/.ssh/config",
    "knownHostsPath": "~/.ssh/known_hosts"
  },
  "dataDir": "~/.routequay",
  "nodes": [
    {
      "id": "example-node",
      "displayName": "Example node",
      "sshAlias": "example-node",
      "host": "vpn.example.invalid",
      "user": "example-user",
      "port": 22,
      "identityFile": "~/.ssh/id_ed25519_example",
      "authMethod": "ssh-config"
    }
  ]
}
